# Noms des variables d'environnement d'Argos, avec des valeurs FACTICES.
# Les vraies valeurs : kit secrets add NOM        (projet : secrets/dev.enc.json)
#                      kit secrets add NOM -g     (clé partagée entre projets)
# Vérifier : kit secrets check
# En production, les valeurs vivent dans la ressource Coolify (voir DEPLOY.md).

# --- Application (exécution) ---
# Adresse d'écoute HTTP (défaut : :8080)
ARGOS_ADDR=:8080
# Dossier des données persistantes : SQLite + clés SSH (défaut : /data)
ARGOS_DATA_DIR=./data
# Hash argon2id du mot de passe du compte unique (SECRET)
ARGOS_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=2$changeme$changeme
# Clé de signature des cookies de session, 32 octets en base64 (SECRET)
ARGOS_SESSION_KEY=changeme

# --- Outillage de déploiement (kit api, globales -g) ---
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_ACCESS_TOKEN=changeme
CLOUDFLARE_API_TOKEN=changeme
